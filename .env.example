# General application settings
APP_ENV=development
CORS_ALLOWED_ORIGINS=
DATA_FILE=./data/sessions.sqlite3

# Local inference: JobiGo -> Ollama -> Gemma 3 4B
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
GEMMA_TIMEOUT_SECONDS=90

# Production inference: set AI_PROVIDER=openrouter and add the key in the host's secret settings.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-3-4b-it
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=90

# Optional voice provider: ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Private-demo access: empty locally; required in production.
DEMO_ACCESS_USERNAME=jobigo
DEMO_ACCESS_TOKEN=
